# Windows .env (never commit a real token)
VOICE_WS_URL=wss://replace-with-your-trycloudflare-domain/ws
VOICE_API_TOKEN=replace-with-long-random-token
AEC_ENABLED=0
AEC_DELAY_MS=40
VAD_MODE=2
FORCE_BARGE_MS=1100
OVERLAP_DUCK_GAIN=0.35
# GPU server variables; configure via Kaggle secrets and environment
ASR_MODEL=small
ASR_DEVICE=cuda
ASR_COMPUTE=int8_float16
ASR_GPU_INDEX=0
ASR_BEAM_SIZE=1
PARTIAL_ASR_ENABLED=1
ASR_LANGUAGE=auto
SMART_TURN_ENABLED=1
SMART_TURN_WEIGHTS=smart-turn-v3.2-cpu.onnx
TTS_PROVIDER=omnivoice
TTS_GPU=auto
VOICE_DIR=voices
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_STEPS=16
ALLOW_BACKCHANNEL=0
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=
LLM_BACKEND=api
LOCAL_LLM_MODEL=Qwen/Qwen3-0.6B
LOCAL_LLM_DEVICE=cuda:0
LOCAL_LLM_MAX_TOKENS=180
LOCAL_LLM_GPU_INDEX=0
