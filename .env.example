# Windows client (set these two ONLY on your Windows PC)
VOICE_WS_URL=wss://replace-with-your-cloudflare-tunnel/ws
VOICE_API_TOKEN=replace-with-your-private-token
AEC_ENABLED=0
VAD_MODE=2
VAD_ONSET_FRAMES=5
FORCE_BARGE_MS=1100
OVERLAP_DUCK_GAIN=0.35

# Kaggle server: use Kaggle Secrets for GROQ_API_KEY / GEMINI_API_KEY
# Primary temporary free hosted LLM: groq (or choose gemini)
LLM_BACKEND=groq
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=140
# Do not store real API keys in this file or GitHub
# GROQ_API_KEY=
# GEMINI_API_KEY=

ASR_MODEL=medium
ASR_DEVICE=cuda
ASR_GPU_INDEX=0
ASR_COMPUTE=int8_float16
ASR_BEAM_SIZE=3
ASR_LANGUAGE=auto
ASR_ALLOWED_LANGUAGES=en,ta
ASR_HOTWORDS=Jarvis
ASR_MIN_RMS=0.003
ASR_MIN_AVG_LOGPROB=-1.25
ASR_NO_SPEECH_THRESHOLD=0.6
PARTIAL_ASR_ENABLED=0

SMART_TURN_ENABLED=0
ENDPOINT_FALLBACK_MS=850
ALLOW_BACKCHANNEL=0

TTS_PROVIDER=omnivoice
TTS_GPU=1
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_STEPS=12
VOICE_DIR=voices

# Long-form /debug/tts: no silent truncation; 100-char chunks then join
TTS_CHUNK_MAX_CHARS=100
TTS_CHUNK_GAP_MS=100
TTS_MAX_TEXT_CHARS=5000
