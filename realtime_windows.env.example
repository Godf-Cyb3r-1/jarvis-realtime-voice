# Windows machine ONLY. Save a copy as .env (do not commit private credentials).
# Cloudflare Quick Tunnel URLs are temporary and change when Kaggle restarts.
STT_WS_URL=wss://replace-stt.trycloudflare.com/stt
STT_WS_TOKEN=your-own-random-24plus-character-stt-token
TTS_WS_URL=wss://replace-tts.trycloudflare.com/tts
TTS_WS_TOKEN=your-own-different-24plus-character-tts-token

# Groq is called from Windows, NOT either Kaggle session.
LLM_BACKEND=groq
GROQ_API_KEY=your-private-free-tier-groq-key
GROQ_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=160

JARVIS_MEMORY_DB=jarvis_conversation.sqlite3
AEC_ENABLED=0
HEADPHONES=1
VAD_MODE=2
VAD_ONSET_FRAMES=5
# Suppress low-energy WebRTC VAD false alarms (values are normalized PCM RMS).
# If Jarvis cannot hear quiet speech, lower VAD_RMS_MIN towards 0.004.
VAD_RMS_MIN=0.008
# Higher threshold while Jarvis is speaking; reduces echo/self-interruption.
VAD_BARGE_RMS_MIN=0.020
VAD_BARGE_ONSET_FRAMES=7
VAD_NOISE_RATIO=2.5
FORCE_BARGE_MS=850
OVERLAP_DUCK_GAIN=0.25
ENABLE_PREFILL=1
ENABLE_BACKCHANNELS=1


# Debug silent replies first: keep unrelated GPU warmups out of the way.
TTS_PREWARM_ACKS=0
# Optional PortAudio IDs (use python -m sounddevice to list them)
# MIC_DEVICE=1
# SPEAKER_DEVICE=3
